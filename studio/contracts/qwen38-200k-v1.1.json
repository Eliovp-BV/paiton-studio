{
  "schema": 1,
  "profile": "agentic-200k-v1",
  "profile_revision": 1,
  "based_on": "engine-profile.json",
  "validation_scope": "One active request; synthetic 195999-token prompt plus 57-token response, three-marker retrieval smoke only; tight VRAM headroom, no full benchmark or long-context model-quality qualification",
  "arguments": [
    "--model",
    "/models/target",
    "--tokenizer",
    "/models/target",
    "--served-model-name",
    "Qwen3.8-27B-Quark-AWQ-MXFP4",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--tensor-parallel-size",
    "1",
    "--dtype",
    "bfloat16",
    "--max-model-len",
    "200000",
    "--max-num-seqs",
    "1",
    "--max-num-batched-tokens",
    "4096",
    "--kv-cache-dtype",
    "fp8",
    "--kv-cache-memory-bytes",
    "8589934592",
    "--gpu-memory-utilization",
    "0.95",
    "--no-enable-prefix-caching",
    "--enable-chunked-prefill",
    "--language-model-only",
    "--safetensors-load-strategy",
    "lazy",
